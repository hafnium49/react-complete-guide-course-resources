# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (may contain sensitive variables)
*.tfvars
*.tfvars.json

# Override files (used for local overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
